<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        meal_plan_id refers to the plan by id; its foreign key comes from ForeignKeySchema.
        replaceItems() reuses the (list, position) keys of the old items; storing it in one
        flush works through ShoppingListItemsReplacement (a preFlush listener).
    -->
    <entity name="App\Planning\Domain\Model\ShoppingList" table="planning_shopping_lists">
        <unique-constraints>
            <!-- SHL-01: one list per plan. -->
            <unique-constraint name="uq_planning_shopping_lists_meal_plan_id" columns="meal_plan_id"/>
        </unique-constraints>

        <id name="id" type="shopping_list_id"/>

        <field name="mealPlanId" column="meal_plan_id" type="meal_plan_id"/>
        <field name="generatedAt" column="generated_at" type="datetimetz_micro_immutable"/>

        <one-to-many field="items" target-entity="App\Planning\Domain\Model\ShoppingItem"
                     mapped-by="shoppingList" orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
